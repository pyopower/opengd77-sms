# Build output (Makefile-driven)
MDUV380_firmware/build/
MDUV380_firmware/dist/

# Codec placeholder produced by `codec_cleaner -C`
MDUV380_firmware/application/source/linkerdata/codec_bin_section_1.bin

# Compiler outputs
*.o
*.d
*.elf
*.map
*.lst
*.su

# STM32CubeIDE workspace state
.metadata/
Debug/
Release/
.cubeide-workspace/

# Local DM1701 build output (was previously committed; untracked for local dev)
V3_TEST/MDUV380_firmware/DM1701_FW/
*.cyclo

# Proprietary donor/official firmware (never redistribute)
donor/
*.donor.bin

# macOS
.DS_Store

# Python
__pycache__/
*.pyc

# Local-only notes containing hotspot credentials and full replay-rig scripts (never commit)
DOCUMENTATIE/hotspot_replay_rig_LOCAL_ONLY.md

# TG950 chop investigation: raw captures, hotspot config backups, credentials (never commit)
INVESTIGATION_LOCAL_ONLY/

# --- opengd77-sms: never commit build output or codec files ---
# codec_bin_section_1.bin is generated by tools/codec_cleaner -C (prepare / prepare.bat);
# the real AMBE codec comes from each user's own original firmware and is never distributed.
codec_bin_section_*.bin
*.bin
*.elf
*.hex
*.map
*.list
*.o
*.d
*.su
*.cyclo
*.zip
**/MDUV380_firmware/*_FW/
**/MD9600_firmware/MD9600_HW_V*/
.headless-workspace/
# ...except the web flasher's release images: built with codec_cleaner -i, verified codec-free
!docs/flasher/firmware/*.bin
